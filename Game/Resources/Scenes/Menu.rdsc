{
  "camera": {
    "translation": [0, 0, 4],
    "rotation": [0, 0, 0],
    "fov": 45.0,
    "nearPlane": 0.1,
    "farPlane": 100.0
  },
  "shaders": {
    "default": {
      "vertex": "Shaders/default.vert",
      "fragment": "Shaders/default.frag"
    },
    "reversedColors": {
      "vertex": "Shaders/reversedcolors.vert",
      "fragment": "Shaders/reversedcolors.frag"
    }
  },

  "textures": {
    "default": "Textures/PixelText.png",
    "modelface": "Textures/PixelText.png"
  },

  "audio": {
    "test": {
      "file": "Audio/test.wav",
      "spatialized": true
    }
  },

  "gameObjects": [
    {
      "name": "Player",
      "components": {
        "transform": {
          "translation": [2, 0, 0],
          "scale": [1, 1, 1],
          "rotation": [0, 0, 0]
        },
        "render": {
          "shader": "default",
          "texture": "default"
        },
        "audioListener": {
          "translation": [0, 0, 0],
          "rotation": [0, 0, 0]
        },
        "script" : "Scripts/test.lua"
      }
    },
    {
      "name": "Reyalp",
      "components": {
        "transform": {
          "translation": [-2, 0, 0],
          "scale": [1, 1, 1],
          "rotation": [0, 0, 0]
        },
        "render": {
          "shader": "reversedColors",
          "texture": "modelface"
        },        
        "audioPlayer": {
          "translation": [0, 0, 0],
          "audio": "test"
        }
      }
    }
  ]

}

